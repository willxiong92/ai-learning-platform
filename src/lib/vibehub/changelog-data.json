              "cn": "事务",
              "en": "Transaction",
              "cat": "数据库"
            },
            {
              "href": "/atomicity",
              "title": "一组相关操作要么整体生效，要么整体不生效，中间结果不能被当成最终结果。",
              "cn": "原子性",
              "en": "Atomicity",
              "cat": "后端开发"
            },
            {
              "href": "/database-write",
              "title": "把新增或修改的数据写入数据库并完成提交。",
              "cn": "写入数据库",
              "en": "Database Write",
              "cat": "数据库"
            },
            {
              "href": "/process",
              "title": "操作系统中正在运行的程序实例，拥有独立的内存空间、系统资源和进程编号（PID）。",
              "cn": "进程",
              "en": "Process",
              "cat": "后端开发"
            },
            {
              "href": "/thread",
              "title": "进程内部由操作系统调度的最小执行单元；同一进程内的多个线程通常共享内存与系统资源。",
              "cn": "线程",
              "en": "Thread",
              "cat": "后端开发"
            },
            {
              "href": "/coroutine",
              "title": "在明确暂停点主动挂起并让出执行权、待条件满足后再恢复执行的轻量级并发单元。",
              "cn": "协程",
              "en": "Coroutine",
              "cat": "后端开发"
            },
            {
              "href": "/enqueue",
              "title": "将待处理任务写入队列暂存，使当前请求能先获得任务凭证并快速返回，再由后台异步执行的操作。",
              "cn": "入队",
              "en": "Enqueue",
              "cat": "接口与数据"
            },
            {
              "href": "/idempotency",
              "title": "同一个请求重复到达时，预期的业务效果仍只发生一次。",
              "cn": "幂等",
              "en": "Idempotency",
              "cat": "接口与数据"
            },
            {
              "href": "/side-effect",
              "title": "函数或请求在计算返回自身结果之外，对外部系统状态造成的变更或触发的额外操作。",
              "cn": "副作用",
              "en": "Side Effect",
              "cat": "后端开发"
            },
            {
              "href": "/lock",
              "title": "限制多个并发操作同时访问同一共享资源，确保同一时间只有一个执行者能够修改状态的同步机制。",
              "cn": "锁",
              "en": "Lock",
              "cat": "后端开发"
            },
            {
              "href": "/race-condition",
              "title": "多个并发操作因执行时序或交错顺序不确定，导致系统出现偶发错误或状态不一致的并发缺陷。",
              "cn": "竞态条件",
              "en": "Race Condition",
              "cat": "后端开发"
            },
            {
              "href": "/audit-log",
              "title": "按时间顺序记录谁在何时对什么对象执行了什么操作，以及最终成功或被拒绝的结果。",
              "cn": "审计日志",
              "en": "Audit Log",
              "cat": "账号与权限"
            }
          ]
        }
      ]

{
  "name": "okki-ai-learning",
  "version": "0.4.0",
  "private": true,
  "description": "OKKI team AI learning platform: courses, terminology and article library",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/willxiong92/ai-learning-platform.git"
  },
  "homepage": "https://okki-team-ai-learning.willxiong92.chatgpt.site",
  "bugs": {
    "url": "https://github.com/willxiong92/ai-learning-platform/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "content:ai": "node scripts/generate-ai-learning.mjs && node scripts/render-ai-learning.mjs",
    "content:collab": "node scripts/sync-collab-handbook.mjs",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "content:guide": "python3 scripts/import-ai-guide.py --generate-only && python3 scripts/prepare-guide-reading.py",
    "test:guide": "node --test scripts/ai-guide.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

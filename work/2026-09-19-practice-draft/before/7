/* AI learning pages (/learning). Every selector is scoped to .ai-learning-*
   so the cloned site's own styles stay untouched. Colors inherit the current
   theme text color and mix borders/backgrounds from it, so light and dark
   color modes both work without new tokens. */

.ai-learning-page {
  --ai-learning-line: color-mix(in oklab, currentColor 14%, transparent);
  --ai-learning-soft: color-mix(in oklab, currentColor 5%, transparent);
  --ai-learning-muted: color-mix(in oklab, currentColor 64%, transparent);
  /* Space kept above anchor targets so the fixed site nav (108px tall at 390px
     wide) never covers a jumped-to heading; 8rem = 128px on every screen. */
  --ai-learning-anchor-offset: 8rem;
  width: 100%;
  max-width: 46rem;
  margin: 0 auto;
  padding: 2rem 1rem 4rem;
  line-height: 1.75;
  overflow-wrap: anywhere;
}

.ai-learning-page a {
  text-decoration: underline;
  text-underline-offset: 0.2em;
}

.ai-learning-breadcrumb {
  font-size: 0.875rem;
  color: var(--ai-learning-muted);
  margin-bottom: 1rem;
}

.ai-learning-header {
  margin-bottom: 2rem;
}

.ai-learning-header h1,
.ai-learning-prose h1 {
  font-size: 1.75rem;
  line-height: 1.3;
  font-weight: 700;
  margin: 0.25rem 0 1rem;
}

.ai-learning-kicker {
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--ai-learning-muted);
  margin: 0;
}

.ai-learning-note {
  font-size: 0.875rem;
  color: var(--ai-learning-muted);
}

.ai-learning-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin: 0.75rem 0;
}

.ai-learning-badge {
  display: inline-block;
  font-size: 0.75rem;
  line-height: 1.5;
  padding: 0.125rem 0.5rem;
  border: 1px solid var(--ai-learning-line);
  border-radius: 999px;
  background: var(--ai-learning-soft);
  white-space: nowrap;
}

.ai-learning-badge.is-draft,
.ai-learning-badge.is-planned {
  border-style: dashed;
}

.ai-learning-module {
  margin-top: 2.5rem;
}

.ai-learning-module h2 {
  font-size: 1.25rem;
  font-weight: 700;
  margin: 0 0 0.5rem;
}

.ai-learning-lesson-list {
  list-style: none;
  padding: 0;
  margin: 1rem 0 0;
  display: grid;
  gap: 0.75rem;
}

.ai-learning-lesson-card {
  border: 1px solid var(--ai-learning-line);
  border-radius: var(--radius, 0.625rem);
  padding: 1rem;
}

.ai-learning-lesson-card.is-planned {
  border-style: dashed;
}

.ai-learning-lesson-title {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.5rem;
  font-weight: 600;
  margin: 0 0 0.5rem;
}

.ai-learning-meta-list,
.ai-learning-intro-list {
  display: grid;
  grid-template-columns: max-content 1fr;
  gap: 0.25rem 1rem;
  font-size: 0.9375rem;
  margin: 0.5rem 0 0;
}

.ai-learning-meta-list dt,
.ai-learning-intro-list dt {
  color: var(--ai-learning-muted);
}

.ai-learning-meta-list dd,
.ai-learning-intro-list dd {
  margin: 0;
}

.ai-learning-toc {
  border-left: 2px solid var(--ai-learning-line);
  padding-left: 1rem;
  margin-bottom: 2rem;
  font-size: 0.9375rem;
}

.ai-learning-toc ol {
  list-style: none;
  padding: 0;
  margin: 0.5rem 0 0;
}

.ai-learning-empty {
  border: 1px dashed var(--ai-learning-line);
  border-radius: var(--radius, 0.625rem);
  padding: 1rem;
}

/* Rendered lesson body */
.ai-learning-prose h2 {
  font-size: 1.3rem;
  font-weight: 700;
  line-height: 1.4;
  margin: 2.5rem 0 1rem;
  scroll-margin-top: var(--ai-learning-anchor-offset);
}

.ai-learning-prose h1,
.ai-learning-prose [id] {
  scroll-margin-top: var(--ai-learning-anchor-offset);
}

.ai-learning-prose .header-anchor {
  margin-left: 0.25rem;
  text-decoration: none;
  opacity: 0;
}

.ai-learning-prose h2:hover .header-anchor {
  opacity: 0.5;
}

.ai-learning-prose p,
.ai-learning-prose ul,
.ai-learning-prose ol,
.ai-learning-prose blockquote,
.ai-learning-prose figure,
.ai-learning-prose details {
  margin: 0 0 1rem;
}

.ai-learning-prose ul {
  list-style: disc;
  padding-left: 1.5rem;
}

.ai-learning-prose ol {
  list-style: decimal;
  padding-left: 1.5rem;
}

.ai-learning-prose blockquote {
  border-left: 3px solid var(--ai-learning-line);
  padding-left: 1rem;
  color: var(--ai-learning-muted);
}

/* Tables scroll inside themselves on narrow screens instead of widening the page */
.ai-learning-prose table {
  display: block;
  max-width: 100%;
  overflow-x: auto;
  border-collapse: collapse;
  font-size: 0.875rem;
  margin: 0 0 1rem;
}

.ai-learning-prose th,
.ai-learning-prose td {
  border: 1px solid var(--ai-learning-line);
  padding: 0.375rem 0.625rem;
  text-align: left;
  vertical-align: top;
  min-width: 6rem;
}

.ai-learning-prose th {
  background: var(--ai-learning-soft);
  font-weight: 600;
}

.ai-learning-prose pre {
  overflow-x: auto;
  padding: 0.875rem 1rem;
  border-radius: var(--radius, 0.625rem);
  background: var(--ai-learning-soft);
  border: 1px solid var(--ai-learning-line);
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 0.8125rem;
  line-height: 1.7;
}

.ai-learning-prose [class^="language-"] {
  position: relative;
  margin: 0 0 1rem;
}

.ai-learning-prose [class^="language-"] .lang {
  display: none;
}

.ai-learning-prose code {
  font-family: var(--font-mono, ui-monospace, monospace);
}

/* VitePress containers: ::: info / ::: tip / ::: details */
.ai-learning-prose .custom-block {
  border: 1px solid var(--ai-learning-line);
  border-radius: var(--radius, 0.625rem);
  background: var(--ai-learning-soft);
  padding: 0.75rem 1rem;
}

.ai-learning-prose .custom-block > :last-child {
  margin-bottom: 0;
}

.ai-learning-prose .custom-block-title {
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.ai-learning-prose summary {
  cursor: pointer;
  font-weight: 600;
}

/* Lesson figures (hand-written structural HTML in the sources) */
.ai-learning-prose .lesson-figure {
  border: 1px solid var(--ai-learning-line);
  border-radius: var(--radius, 0.625rem);
  padding: 1rem;
}

.ai-learning-prose .lesson-figure figcaption {
  font-weight: 600;
  margin-bottom: 0.75rem;
}

.ai-learning-prose .flow,
.ai-learning-prose .ladder {
  list-style: none;
  padding: 0;
  display: grid;
  gap: 0.5rem;
  counter-reset: ai-learning-step;
}

.ai-learning-prose .flow li,
.ai-learning-prose .ladder li {
  counter-increment: ai-learning-step;
  border: 1px solid var(--ai-learning-line);
  border-radius: calc(var(--radius, 0.625rem) * 0.8);
  padding: 0.5rem 0.75rem;
}

.ai-learning-prose .flow li::before,
.ai-learning-prose .ladder li::before {
  content: counter(ai-learning-step) ". ";
  color: var(--ai-learning-muted);
}

.ai-learning-prose .flow li span,
.ai-learning-prose .ladder li span,
.ai-learning-prose .box-part small {
  display: block;
  font-size: 0.8125rem;
  color: var(--ai-learning-muted);
}

.ai-learning-prose .box-outer {
  border: 1px dashed var(--ai-learning-line);
  border-radius: var(--radius, 0.625rem);
  padding: 0.75rem;
}

.ai-learning-prose .box-label {
  display: block;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.ai-learning-prose .box-row,
.ai-learning-prose .context-diagram {
  display: grid;
  gap: 0.5rem;
  grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
}

.ai-learning-prose .box-part,
.ai-learning-prose .context-in,
.ai-learning-prose .context-out {
  border: 1px solid var(--ai-learning-line);
  border-radius: calc(var(--radius, 0.625rem) * 0.8);
  padding: 0.5rem 0.75rem;
}

.ai-learning-prose .box-core {
  border-width: 2px;
}

.ai-learning-prose .context-out {
  border-style: dashed;
}

.ai-learning-prose .figure-note {
  font-size: 0.8125rem;
  color: var(--ai-learning-muted);
  margin: 0.75rem 0 0;
}

/* Expanded textbook components */
.ai-learning-intro,
.ai-learning-demo,
.ai-learning-practice,
.ai-learning-status,
.ai-learning-next,
.ai-learning-sources {
  border: 1px solid var(--ai-learning-line);
  border-radius: var(--radius, 0.625rem);
  padding: 1rem;
  margin: 0 0 1.5rem;
}

.ai-learning-status {
  border-style: dashed;
}

.ai-learning-sources h2 {
  margin-top: 0;
}

.ai-learning-terms {
  display: grid;
  gap: 0.75rem;
  grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  margin: 0 0 1.5rem;
}

.ai-learning-term {
  border: 1px solid var(--ai-learning-line);
  border-radius: var(--radius, 0.625rem);
  padding: 0.75rem;
  font-size: 0.9375rem;
}

.ai-learning-term p {
  margin: 0 0 0.375rem;
}

.ai-learning-term-en,
.ai-learning-term-meta,
.ai-learning-source-id {
  font-size: 0.8125rem;
  color: var(--ai-learning-muted);
}

.ai-learning-cite {
  font-size: 0.8125rem;
  color: var(--ai-learning-muted);
}

.ai-learning-demo-steps {
  list-style: none !important;
  padding: 0 !important;
  display: grid;
  gap: 0.75rem;
}

.ai-learning-demo-step {
  border-top: 1px solid var(--ai-learning-line);
  padding-top: 0.75rem;
}

.ai-learning-demo-step dl {
  display: grid;
  grid-template-columns: max-content 1fr;
  gap: 0.25rem 1rem;
  margin: 0;
}

.ai-learning-demo-step dt {
  color: var(--ai-learning-muted);
}

.ai-learning-demo-step dd {
  margin: 0;
}

.ai-learning-multiline {
  white-space: pre-wrap;
}

.ai-learning-output {
  background: var(--ai-learning-soft);
  border-radius: calc(var(--radius, 0.625rem) * 0.6);
  padding: 0.375rem 0.625rem;
}

.ai-learning-details {
  border: 1px solid var(--ai-learning-line);
  border-radius: calc(var(--radius, 0.625rem) * 0.8);
  padding: 0.5rem 0.75rem;
}

.ai-learning-details[open] summary {
  margin-bottom: 0.5rem;
}

/* Live assessment (#assessment): read mark, quiz, feedback, self-check */
.ai-learning-assessment {
  border: 1px solid var(--ai-learning-line);
  border-radius: var(--radius, 0.625rem);
  padding: 1rem;
  margin-top: 2.5rem;
  scroll-margin-top: var(--ai-learning-anchor-offset);
}

.ai-learning-assessment h2 {
  font-size: 1.3rem;
  font-weight: 700;
  line-height: 1.4;
  margin: 0 0 0.5rem;
}

.ai-learning-assessment h3 {
  font-size: 1.05rem;
  font-weight: 700;
  margin: 0 0 0.5rem;
}

.ai-learning-assessment p {
  margin: 0 0 0.5rem;
}

.ai-learning-assessment-status,
.ai-learning-assessment-block {
  border-top: 1px solid var(--ai-learning-line);
  padding-top: 1rem;
  margin-top: 1rem;
}

.ai-learning-quiz,
.ai-learning-result {
  display: grid;
  gap: 1rem;
}

.ai-learning-question {
  border: 1px solid var(--ai-learning-line);
  border-radius: calc(var(--radius, 0.625rem) * 0.8);
  padding: 0.75rem;
  margin: 0;
  min-width: 0;
}

.ai-learning-question legend,
.ai-learning-question > label {
  display: block;
  font-weight: 600;
  padding: 0 0.25rem;
}

.ai-learning-question-no {
  color: var(--ai-learning-muted);
  margin-right: 0.375rem;
}

.ai-learning-question .ai-learning-badge {
  margin-right: 0.375rem;
}

.ai-learning-option {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  padding: 0.25rem 0;
  cursor: pointer;
}

.ai-learning-option input {
  margin-top: 0.45em;
  flex: none;
  accent-color: currentColor;
}

.ai-learning-textarea {
  display: block;
  width: 100%;
  margin-top: 0.5rem;
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--ai-learning-line);
  border-radius: calc(var(--radius, 0.625rem) * 0.6);
  background: transparent;
  color: inherit;
  font: inherit;
  resize: vertical;
}

.ai-learning-button {
  display: inline-block;
  font: inherit;
  font-size: 0.9375rem;
  color: inherit;
  padding: 0.375rem 0.875rem;
  border: 1px solid var(--ai-learning-line);
  border-radius: calc(var(--radius, 0.625rem) * 0.8);
  background: var(--ai-learning-soft);
  cursor: pointer;
  justify-self: start;
}

.ai-learning-button.is-primary {
  border-color: currentColor;
  font-weight: 600;
}

.ai-learning-button:disabled {
  opacity: 0.6;
  cursor: progress;
}

.ai-learning-button:focus-visible,
.ai-learning-textarea:focus-visible,
.ai-learning-option input:focus-visible,
.ai-learning-warning:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

.ai-learning-warning {
  border: 1px dashed currentColor;
  border-radius: calc(var(--radius, 0.625rem) * 0.8);
  padding: 0.5rem 0.75rem;
  font-size: 0.9375rem;
  margin: 0.5rem 0;
}

.ai-learning-warning p,
.ai-learning-warning ul {
  margin: 0;
}

.ai-learning-warning ul {
  list-style: disc;
  padding-left: 1.5rem;
}

.ai-learning-result-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 0.75rem;
}

.ai-learning-result-list li {
  border-left: 3px solid var(--ai-learning-line);
  padding-left: 0.75rem;
}

.ai-learning-result-list li.is-wrong {
  border-left-style: dashed;
  border-left-color: currentColor;
}

.ai-learning-badge.is-progress {
  white-space: normal;
}

/* 我的学习 (/learning/me) */
.ai-learning-me-next {
  font-weight: 600;
  margin: 0.75rem 0 0;
}

.ai-learning-me-card.is-self_check_complete {
  border-color: color-mix(in oklab, currentColor 32%, transparent);
}

.ai-learning-pager {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
  margin-top: 3rem;
}

.ai-learning-pager-link {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  border: 1px solid var(--ai-learning-line);
  border-radius: var(--radius, 0.625rem);
  padding: 0.75rem;
  text-decoration: none !important;
}

.ai-learning-pager-link.is-planned {
  border-style: dashed;
}

.ai-learning-pager-link .ai-learning-badge {
  align-self: flex-start;
}

@media (max-width: 640px) {
  .ai-learning-page {
    padding: 1.25rem 1rem 3rem;
  }

  .ai-learning-meta-list,
  .ai-learning-intro-list,
  .ai-learning-demo-step dl {
    grid-template-columns: 1fr;
  }

  .ai-learning-meta-list dd,
  .ai-learning-intro-list dd,
  .ai-learning-demo-step dd {
    margin-bottom: 0.5rem;
  }

  .ai-learning-pager {
    grid-template-columns: 1fr;
  }
}

import Link from 'next/link';
import { notFound } from 'next/navigation';
import { practiceCases, getPracticeCase, practiceCaseAliases } from '@/lib/ai-learning/practice-cases';
import { curriculumLessonHref, learningUnit } from '@/lib/ai-learning/practice-curriculum';
import '../../../learning-paths.css';
import '../../practice-cases.css';
export function generateStaticParams() { return [...practiceCases.map(c=>({caseId:c.id})), ...Object.keys(practiceCaseAliases).map(caseId=>({caseId}))]; }
export async function generateMetadata({params}:{params:Promise<{caseId:string}>}) { const c=getPracticeCase((await params).caseId); return {title:`${c?.title ?? '案例'}｜AI 学习站`}; }
export default async function PracticeCasePage({params}:{params:Promise<{caseId:string}>}) {
 const c=getPracticeCase((await params).caseId); if(!c) notFound();
 return <article className="learning-hub practice-task"><nav className="learning-breadcrumb" aria-label="位置"><Link href="/practice">实践</Link><span>/</span><span>{c.level}</span></nav>
 <header className="learning-hero"><p className="learning-eyebrow">{c.status==='pilot'?'入门案例 · 教学模拟，可试做':'可选案例规划 · 材料待完善'}</p><h1>{c.title}</h1><p>{c.brief ?? c.scene}</p></header>
 <div className="task-deliverable"><strong>{c.status === 'pilot' && c.materials ? '这一轮只围绕一份成果' : '规划中的成果形式（尚未开放）'}</strong><p>{c.outcome}</p></div>
 <section className="task-section"><h2>这个案例检验什么</h2><ul className="case-points">{c.points.map(p=><li key={p}>{p}</li>)}</ul><details><summary>卡住时，回到相关课程补知识</summary><ul>{c.lessons.map(id=><li key={id}><Link href={curriculumLessonHref(id)}>{id.toUpperCase()} · {learningUnit(id)?.title}</Link></li>)}</ul><p>按遇到的问题补课，不要求为每课另做一次实践。</p></details></section>
 {c.materials ? <>
 <section className="task-section"><h2>01 · 同一份业务委托与材料</h2><p>只使用以下模拟材料。本站不上传文件、不调用模型，也不自动保存完成状态。</p><pre className="task-material">{c.materials}</pre><a href={`/practice-materials/${c.id}.txt`} download>下载案例材料（TXT） ↓</a></section>
 <section className="task-section"><h2>02 · 把工作流跑通</h2>{c.starterPrompt && <details open><summary>第一课可直接使用的起步指令</summary><pre className="task-material">{c.starterPrompt}</pre></details>}<ol className="case-workflow">{c.steps?.map(s=><li key={s.title}><h3>{s.title}</h3><p>{s.action}</p><p className="learning-muted">留下证据：{s.evidence}</p></li>)}</ol></section>
 <section className="task-section"><h2>03 · 用同一套标准检查</h2><ul>{c.checks?.map(x=><li key={x}>{x}</li>)}</ul><p>案例完成意味着留下可检查的过程与结果，不等于获得生产交付资格；有差异就修订并复测，不用一次正确代替稳定性验证。</p><h3>先做基线，再试一次变化</h3>{c.tests?.map(t=><div className="case-test" key={t.name}><h3>{t.name}</h3><p>{t.change}</p><details><summary>完成后核对预期</summary><p>{t.expect}</p></details></div>)}</section>
 <section className="task-section"><h2>04 · 对照参照，补齐交付</h2><details className="task-reference"><summary>展开一种合格交付参照</summary><p>参照只说明思路与边界，不提供虚构实跑记录。先保存自己的首次结果。</p><pre className="task-material">{c.reference}</pre></details></section>
 </> : <section className="task-section"><h2>案例准备方向</h2><p>{c.scene}</p><p><strong>预计成果形式：</strong>{c.outcome}</p><p>完整委托、模拟材料、步骤和测试参照尚未准备好，当前不作为可完成任务。相关课程按需学习，不必一次完成所有进阶分支。</p></section>}
 {c.extensions && <section className="task-section"><h2>第一课做到哪里，后面怎样继续</h2><ul>{c.extensions.map(item=><li key={item}>{item}</li>)}</ul></section>}
 {c.sources && <details className="task-section"><summary>场景来源与使用边界</summary><p>场景依据与模拟材料分开：以下页面只作选题参考，本文材料由教学创作提供。来源核对日期：2026-09-20；不以平台推荐或下载量证明实际效果。</p><ul>{c.sources.map(source=><li key={source.url}><a href={source.url} target="_blank" rel="noreferrer">{source.label}</a></li>)}</ul></details>}
 <footer className="learning-actions"><Link href="/practice">← 返回业务案例</Link><Link href="/courses">按需补课 →</Link></footer></article>;

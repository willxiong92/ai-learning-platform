import Link from "next/link";
import type { Metadata } from "next";
import {
  getCourseMeta,
  getLessonStatusLabel,
  getLessonSummary,
  getModules,
  getReviewLabel,
} from "@/lib/ai-learning/catalog";
import "./learning.css";

export const metadata: Metadata = {
  title: "学习路线｜AI 学习站",
  description: "AI 学习站课程地图：6 个模块、24 课，草稿试读版。",
};

const pad = (n: number) => String(n).padStart(2, "0");

export default function LearningMapPage() {
  const meta = getCourseMeta();
  const modules = getModules();

  return (
    <div className="ai-learning-page">
      <header className="ai-learning-header">
        <p className="ai-learning-kicker">学习路线</p>
        <h1>{meta.title}</h1>
        <p className="ai-learning-badges">
          <span className="ai-learning-badge is-draft">{getReviewLabel(meta.review)}</span>
          <span className="ai-learning-badge">课程版本 {meta.courseVersion}</span>
          <span className="ai-learning-badge">
            {meta.counts.modules} 个模块 · {meta.counts.lessons} 课 · 可试读 {meta.counts.available} 课 · 待编写{" "}
            {meta.counts.planned} 课
          </span>
        </p>
        {meta.audience && <p>适合：{meta.audience}</p>}
        {meta.depthNote && <p className="ai-learning-note">{meta.depthNote}</p>}
        {meta.period && (
          <p className="ai-learning-note">
            {[
              meta.period.weeks != null ? `约 ${meta.period.weeks} 周` : null,
              meta.period.hoursPerWeek != null ? `每周约 ${meta.period.hoursPerWeek} 小时` : null,
              meta.period.totalHours != null ? `合计约 ${meta.period.totalHours} 小时` : null,
              meta.period.note,
            ]
              .filter(Boolean)
              .join("；")}
          </p>
        )}
        <p className="ai-learning-note">
          本站只提供阅读：测验、阅读进度和成绩功能尚未接入，页面不会显示完成状态或分数。
        </p>
      </header>

      {modules.map((module, moduleIndex) => (
        <section key={module.id} className="ai-learning-module" aria-labelledby={`module-${module.id}`}>
          <h2 id={`module-${module.id}`}>
            模块 {moduleIndex + 1} · {module.title}
          </h2>
          {module.purpose && <p className="ai-learning-note">{module.purpose}</p>}
          <ol className="ai-learning-lesson-list">
            {module.lessons.map((lesson) => (
              <li key={lesson.id} className={`ai-learning-lesson-card is-${lesson.status}`}>
                <p className="ai-learning-lesson-title">
                  <Link href={`/learning/${lesson.id}`}>
                    第 {pad(lesson.order)} 课 · {lesson.title}
                  </Link>
                  <span className={`ai-learning-badge is-${lesson.status}`}>{getLessonStatusLabel(lesson.status)}</span>
                </p>
                {lesson.topics && <p className="ai-learning-note">主题：{lesson.topics}</p>}
                <dl className="ai-learning-meta-list">
                  <dt>为什么学</dt>
                  <dd>{lesson.why}</dd>
                  <dt>学完能做到</dt>
                  <dd>{lesson.outcome}</dd>
                  <dt>怎样检验</dt>
                  <dd>{lesson.verify}</dd>
                  <dt>预计时间</dt>
                  <dd>{lesson.estimate}</dd>
                  <dt>先修</dt>
                  <dd>
                    {lesson.prerequisites.length === 0
                      ? "无"
                      : lesson.prerequisites.map((id, i) => {
                          const pre = getLessonSummary(id);
                          return (
                            <span key={id}>
                              {i > 0 && "、"}
                              <Link href={`/learning/${id}`}>{pre ? `第 ${pad(pre.order)} 课 · ${pre.title}` : id}</Link>
                            </span>
                          );
                        })}
                  </dd>
                </dl>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  );
}

import Link from "next/link";
import type { Metadata } from "next";
import { getCourseMeta, getLessonContent, getLessonSummary, getReviewLabel } from "@/lib/ai-learning/catalog";
import { getCompactAssessments } from "@/lib/ai-learning/activities";
import { MyLearning, type MyLearningLesson } from "@/components/ai-learning/my-learning";
import "../learning.css";

export const metadata: Metadata = {
  title: "我的学习｜AI 学习站",
  description: "本浏览器里的学习记录汇总：已读、测验和自查状态。",
};

export default function MyLearningPage() {
  const meta = getCourseMeta();
  // Server side only: the client gets text-free grading data plus titles, never the full catalog.
  const lessons: MyLearningLesson[] = getCompactAssessments().flatMap(({ lessonId, activities }) => {
    const summary = getLessonSummary(lessonId);
    if (!summary) return [];
    const used = new Set(activities.quiz.questions.map((q) => q.section));
    const sections = (getLessonContent(lessonId)?.sections ?? [])
      .filter((s) => used.has(s.id))
      .map((s) => ({ id: s.id, title: s.title }));
    return [{ id: lessonId, order: summary.order, title: summary.title, activities, sections }];
  });
  lessons.sort((a, b) => a.order - b.order);

  return (
    <div className="ai-learning-page">
      <nav className="ai-learning-breadcrumb" aria-label="面包屑">
        <Link href="/learning">← 返回学习路线</Link>
      </nav>
      <header className="ai-learning-header">
        <p className="ai-learning-kicker">学习记录</p>
        <h1>我的学习</h1>
        <p className="ai-learning-badges">
          <span className="ai-learning-badge is-draft">{getReviewLabel(meta.review)}</span>
          <span className="ai-learning-badge">课程版本 {meta.courseVersion}</span>
        </p>
        <p className="ai-learning-note">
          这里汇总的是当前浏览器里的记录：不上传，换浏览器或设备看不到，清除浏览器数据会丢失。测验是自测，不是正式考试，也不代表人工验收。课程更新后，旧版本的作答单独列出，不计入当前成绩。
        </p>
      </header>
      <MyLearning lessons={lessons} plannedCount={meta.counts.planned} />
    </div>
  );
}

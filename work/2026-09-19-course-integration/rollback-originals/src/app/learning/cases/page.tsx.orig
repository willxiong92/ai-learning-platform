import { Fragment } from "react";
import Link from "next/link";
import type { Metadata } from "next";
import { getLessonSummary } from "@/lib/ai-learning/catalog";
import { PRACTICE_EXERCISE, SC_GAP_PENDING_TEXT } from "@/lib/ai-learning/practice-draft.mjs";
import "../learning.css";

export const metadata: Metadata = {
  title: "模拟案例与作业｜AI 学习站",
  description: "业务案例模板和一份模拟练习。尚无已验收的业务案例。",
};

const pad = (n: number) => String(n).padStart(2, "0");

// What every case must answer. Shown as the template; real cases are not
// collected here yet (submission and review are still pending decisions).
const TEMPLATE: { label: string; hint: string }[] = [
  { label: "业务问题", hint: "要解决什么问题，做到什么算达成。" },
  { label: "对应 SC / 差距", hint: `由业务项目确定；未确定时写“${SC_GAP_PENDING_TEXT}”，不自行编号。` },
  { label: "步骤", hint: "按顺序写，标出哪一步必须人工确认。" },
  { label: "可复用资产", hint: "可以拿去复用的 Prompt、Skill、SOP 或模板。" },
  { label: "证据", hint: "有记录支撑的实际结果；没有就写“待验证”，不写估算数字。" },
  { label: "边界", hint: "不适用的情况、不能交给 AI 的材料、仍需人工把关的地方。" },
  { label: "相关章节", hint: "对应哪几课，方便回看。" },
];

export default function CasesPage() {
  const ex = PRACTICE_EXERCISE;
  return (
    <div className="ai-learning-page">
      <p className="ai-learning-breadcrumb">
        <Link href="/learning">学习路线</Link> / 模拟案例与作业
      </p>
      <header className="ai-learning-header">
        <p className="ai-learning-kicker">案例模板</p>
        <h1>模拟案例与作业</h1>
        <div className="ai-learning-warning ai-learning-case-banner" role="note">
          <p>
            <strong>尚无已验收业务案例；以下为模拟练习，不是客户案例/业务成果。</strong>
          </p>
        </div>
        <p className="ai-learning-note">
          这里先给出案例要写哪些内容，再用一份模拟练习演示怎么区分“材料中记载的信息”和“缺失的信息”。真实案例的收集、提交和审核方式还没有确定，本页不收集任何内容。
        </p>
      </header>

      <section className="ai-learning-case-card" aria-labelledby="template-title">
        <h2 id="template-title">案例模板：每个案例要回答的 7 件事</h2>
        <dl className="ai-learning-meta-list">
          {TEMPLATE.map((item) => (
            <Fragment key={item.label}>
              <dt>{item.label}</dt>
              <dd>{item.hint}</dd>
            </Fragment>
          ))}
        </dl>
      </section>

      <section className="ai-learning-case-card" aria-labelledby="exercise-title">
        <p className="ai-learning-kicker">模拟练习 · 不是客户案例</p>
        <h2 id="exercise-title">{ex.title}</h2>
        <p>{ex.scenario}</p>

        <h3>全部输入材料</h3>
        {ex.sources.map((source) => (
          <div key={source.label} className="ai-learning-source-block">
            <p className="ai-learning-source-label">{source.label}</p>
            <ul>
              {source.lines.map((line) => (
                <li key={line}>{line}</li>
              ))}
            </ul>
          </div>
        ))}

        <div className="ai-learning-case-compare">
          <div>
            <h3>材料中记载的信息</h3>
            <ul>
              {ex.facts.map((line) => (
                <li key={line}>{line}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3>缺失或不能直接下结论的信息</h3>
            <ul>
              {ex.missing.map((line) => (
                <li key={line}>{line}</li>
              ))}
            </ul>
          </div>
        </div>

        <h3>为什么要人来核对</h3>
        <ul>
          {ex.humanCheck.map((line) => (
            <li key={line}>{line}</li>
          ))}
        </ul>

        <dl className="ai-learning-meta-list">
          <dt>对应 SC / 差距</dt>
          <dd>{SC_GAP_PENDING_TEXT}</dd>
          <dt>证据</dt>
          <dd>无：这是模拟练习，没有真实执行结果。</dd>
          <dt>相关章节</dt>
          <dd>
            <ul className="ai-learning-related-list">
              {ex.related.map((r) => {
                const lesson = getLessonSummary(r.lessonId);
                return (
                  <li key={r.lessonId}>
                    <Link href={`/learning/${r.lessonId}`}>
                      {lesson ? `第 ${pad(lesson.order)} 课 · ${lesson.title}` : r.lessonId}
                    </Link>
                    ：{r.focus}
                  </li>
                );
              })}
            </ul>
          </dd>
        </dl>
      </section>

      <p className="ai-learning-me-next">
        <Link href="/learning/practice">动手写一份练习草稿（只存在本浏览器，不提交）→</Link>
      </p>
    </div>
  );
}

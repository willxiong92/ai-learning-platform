+/* AI courses inside /courses. Everything reuses the vibehub course tokens
+   (--text, --text-2, --text-3, --border, --bg-hover, --brand, --green,
+   --warning) so light and dark themes follow the rest of the site. */
+
+/* ---------- /courses: two groups of course cards ---------- */
+
+.course-group + .course-group {
+  margin-top: 56px;
+}
+
+.course-group-heading {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 10px 12px;
+  margin-bottom: 8px;
+}
+
+.course-group-heading h2 {
+  margin: 0;
+  font-size: 20px;
+  font-weight: 720;
+  line-height: 1.3;
+  letter-spacing: -0.02em;
+}
+
+.course-group-links {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 16px;
+  margin: 0 0 20px;
+  font-size: 13px;
+}
+
+.course-group-heading + .course-route-list {
+  margin-top: 20px;
+}
+
+.course-group-links a,
+.ai-course-facts a,
+.ai-course-notes a,
+.ai-course-crumb a {
+  color: var(--brand);
+  text-decoration: underline;
+  text-underline-offset: 0.2em;
+}
+
+/* The upstream amber pill has no dark-mode variant; keep it readable on both. */
+:root[data-color-mode="dark"] .course-status.is-review {
+  color: var(--warning);
+  background: color-mix(in oklab, var(--warning) 16%, transparent);
+}
+
+.course-route-meta .is-available {
+  color: var(--green);
+  font-weight: 650;
+}
+
+/* Courses and chapters that only exist as a plan: visibly quieter, never "clickable to nowhere". */
+.course-route-card.is-planned-course .course-route-list-visual {
+  opacity: 0.55;
+}
+
+.course-chapter-card.is-planned-chapter {
+  border-style: dashed;
+}
+
+.course-chapter-card.is-planned-chapter h3,
+.course-chapter-card.is-planned-chapter p {
+  color: var(--text-3);
+}
+
+/* ---------- course overview ---------- */
+
+.ai-course-facts {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 16px 32px;
+  max-width: 960px;
+  margin: 32px 0 40px;
+  padding: 20px 24px;
+  border: 1px solid var(--border);
+  border-radius: 16px;
+}
+
+.ai-course-facts dt {
+  margin-bottom: 8px;
+  color: var(--text);
+  font-size: 13px;
+  font-weight: 700;
+}
+
+.ai-course-facts dd {
+  margin: 0;
+  color: var(--text-2);
+  font-size: 14px;
+  line-height: 1.65;
+}
+
+.ai-course-facts ul {
+  margin: 0;
+  padding-left: 1.1em;
+}
+
+.ai-course-notes {
+  max-width: 760px;
+  margin: 40px 0 24px;
+  color: var(--text-2);
+  font-size: 13px;
+  line-height: 1.65;
+}
+
+.ai-course-notes summary {
+  cursor: pointer;
+  color: var(--text);
+  font-weight: 650;
+}
+
+.ai-course-notes p {
+  margin: 8px 0 0;
+}
+
+/* ---------- lesson page ---------- */
+
+.ai-course-crumb {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-bottom: 12px;
+  color: var(--text-3);
+  font-size: 13px;
+}
+
+/* learning.css scopes its variables to .ai-learning-page; the lesson here sits
+   in the shared course reader instead, so define them on this wrapper too.
+   .course-article is the scroll container, so anchors only need a small gap. */
+.ai-course-lesson {
+  --ai-learning-line: color-mix(in oklab, currentColor 14%, transparent);
+  --ai-learning-soft: color-mix(in oklab, currentColor 5%, transparent);
+  --ai-learning-muted: color-mix(in oklab, currentColor 64%, transparent);
+  --ai-learning-anchor-offset: 1.5rem;
+  min-width: 0;
+  line-height: 1.7;
+  overflow-wrap: anywhere;
+}
+
+.ai-course-lesson .ai-learning-prose a,
+.ai-course-lesson .ai-learning-empty a {
+  text-decoration: underline;
+  text-underline-offset: 0.2em;
+}
+
+/* The rendered lesson carries its own title; give it the course hero size. */
+.ai-course-lesson .ai-learning-prose h1 {
+  margin: 0 0 12px;
+  font-size: clamp(28px, 3.2vw, 36px);
+  font-weight: 720;
+  line-height: 1.2;
+  letter-spacing: -0.03em;
+  text-wrap: balance;
+}
+
+.ai-course-lesson .course-chapter-hero {
+  margin-bottom: 8px;
+}
+
+.ai-course-lesson .course-bottom-nav {
+  margin-top: 48px;
+}
+
+.ai-course-lesson pre,
+.ai-course-lesson table {
+  max-width: 100%;
+  overflow-x: auto;
+}
+
+@media (max-width: 760px) {
+  .course-group + .course-group {
+    margin-top: 40px;
+  }
+
+  .ai-course-facts {
+    grid-template-columns: minmax(0, 1fr);
+    padding: 16px;
+  }
+}

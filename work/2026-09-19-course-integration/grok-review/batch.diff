+// Overview + chapter list for one AI course (one module of the course source),
+// drawn with the same course-home / course-chapter-card styles as the
+// Web Coding courses. Server component: only text-free grading data and
+// hrefs reach the client progress widgets.
+import Link from "next/link";
+import {
+  getCourseMeta,
+  getLessonSummary,
+  getModules,
+  getReviewLabel,
+  type CourseModule,
+} from "@/lib/ai-learning/catalog";
+import { getCompactAssessments } from "@/lib/ai-learning/activities";
+import {
+  AI_BLUEPRINT_FILE,
+  aiChapterBlueprintId,
+  aiCourseHref,
+  aiLessonHref,
+  availableLessons,
+  getAiCourseNumber,
+} from "@/lib/ai-learning/course-routes";
+import { AiChapterStatus, AiCourseActions, type CourseLessonProgressInput } from "./course-progress";
+
+const pad = (n: number) => String(n).padStart(2, "0");
+
+// Chapter visuals exist only for lessons that have content; planned chapters stay plain.
+const CHAPTER_VISUALS = new Set(["l01", "l02", "l03", "l04"]);
+
+export function AiCourseOverview({ courseModule }: { courseModule: CourseModule }) {
+  const meta = getCourseMeta();
+  const number = getAiCourseNumber(courseModule.id);
+  const modules = getModules();
+  const assessments = new Map(getCompactAssessments().map((a) => [a.lessonId, a.activities]));
+  const ready = availableLessons(courseModule);
+  const progressLessons: CourseLessonProgressInput[] = ready.flatMap((l) => {
+    const activities = assessments.get(l.id);
+    const href = aiLessonHref(l.id);
+    return activities && href ? [{ id: l.id, href, title: l.title, activities }] : [];
+  });
+
+  // Prerequisites that sit in another course; ones inside this course are covered by chapter order.
+  const ownIds = new Set(courseModule.lessons.map((l) => l.id));
+  const outside = [...new Set(courseModule.lessons.flatMap((l) => l.prerequisites))].filter((id) => !ownIds.has(id));
+  const prereqByCourse = new Map<string, string[]>();
+  for (const id of outside) {
+    const pre = getLessonSummary(id);
+    if (!pre) continue;
+    prereqByCourse.set(pre.moduleId, [...(prereqByCourse.get(pre.moduleId) ?? []), id]);
+  }
+
+  return (
+    <div className="course-app course-home-app">
+      <div className="course-home-main">
+        <header className="course-home-intro">
+          <Link className="course-home-back" href="/courses">
+            全部课程
+          </Link>
+          <span className="course-section-eyebrow">AI 应用课程 · 第 {number} 门</span>
+          <h1>{courseModule.title}</h1>
+          {courseModule.purpose && <p className="course-home-lead">{courseModule.purpose}</p>}
+          {progressLessons.length > 0 ? (
+            <AiCourseActions lessons={progressLessons} />
+          ) : (
+            <div className="course-home-actions">
+              <span className="course-status">正文待编写</span>
+              <span className="course-progress-copy">
+                这门课目前只有章节计划，还没有可以学习的正文、练习或测验。
+              </span>
+            </div>
+          )}
+        </header>
+
+        <dl className="ai-course-facts">
+          <div>
+            <dt>学完能做什么</dt>
+            <dd>
+              <ul>
+                {courseModule.lessons.map((l) => (
+                  <li key={l.id}>{l.outcome}</li>
+                ))}
+              </ul>
+            </dd>
+          </div>
+          <div>
+            <dt>先修要求</dt>
+            <dd>
+              {prereqByCourse.size === 0 ? (
+                "无，可以直接从第一章开始。"
+              ) : (
+                <ul>
+                  {[...prereqByCourse].map(([moduleId, ids]) => {
+                    const pre = modules.find((m) => m.id === moduleId);
+                    return (
+                      <li key={moduleId}>
+                        <Link href={aiCourseHref(moduleId)}>{pre?.title ?? moduleId}</Link>：
+                        {ids
+                          .map((id) => {
+                            const l = getLessonSummary(id);
+                            return l ? `第 ${pad(l.order)} 课 ${l.title}` : id;
+                          })
+                          .join("、")}
+                      </li>
+                    );
+                  })}
+                </ul>
+              )}
+            </dd>
+          </div>
+        </dl>
+
+        <nav className="course-chapter-list" aria-label="章节目录">
+          <ol>
+            {courseModule.lessons.map((lesson, index) => {
+              const href = aiLessonHref(lesson.id) ?? aiCourseHref(courseModule.id);
+              const activities = assessments.get(lesson.id);
+              const available = lesson.status === "available";
+              const hasVisual = available && CHAPTER_VISUALS.has(lesson.id);
+              return (
+                <li key={lesson.id}>
+                  <Link
+                    className={`course-chapter-card${hasVisual ? " has-list-visual" : ""}${available ? "" : " is-planned-chapter"}`}
+                    href={href}
+                  >
+                    <div className="course-chapter-summary">
+                      <span className="course-chapter-number">{pad(index + 1)}</span>
+                      <div className="course-chapter-title-row">
+                        <h3>{lesson.title}</h3>
+                        {available && activities ? (
+                          <AiChapterStatus lessonId={lesson.id} activities={activities} />
+                        ) : (
+                          <span className="course-status">待编写</span>
+                        )}
+                      </div>
+                      <p>{available ? lesson.why : `计划：${lesson.outcome}（正文、练习和测验还没有编写）`}</p>
+                    </div>
+                    <span className="course-chapter-card-highlight" aria-hidden="true" />
+                    {hasVisual && (
+                      <span className="course-chapter-list-visual">
+                        <svg width={640} height={640} viewBox="0 0 640 640" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid meet">
+                          <use href={`${AI_BLUEPRINT_FILE}#${aiChapterBlueprintId(lesson.id)}`} />
+                        </svg>
+                      </span>
+                    )}
+                  </Link>
+                </li>
+              );
+            })}
+          </ol>
+        </nav>
+
+        <details className="ai-course-notes">
+          <summary>关于这套 AI 课程</summary>
+          <p>{getReviewLabel(meta.review)} · 课程版本 {meta.courseVersion}</p>
+          {meta.audience && <p>适合：{meta.audience}</p>}
+          {meta.depthNote && <p>{meta.depthNote}</p>}
+          {meta.period && (
+            <p>
+              {[
+                meta.period.weeks != null ? `约 ${meta.period.weeks} 周` : null,
+                meta.period.hoursPerWeek != null ? `每周约 ${meta.period.hoursPerWeek} 小时` : null,
+                meta.period.totalHours != null ? `合计约 ${meta.period.totalHours} 小时` : null,
+                meta.period.note,
+              ]
+                .filter(Boolean)
+                .join("；")}
+            </p>
+          )}
+          <p>
+            学习记录只保存在当前浏览器：换浏览器或设备看不到，清除浏览器数据会丢失。章节测验是自测，不是正式考试，也不代表人工验收。
+          </p>
+          <p>
+            <Link href="/learning/me">我的学习记录</Link> · <Link href="/learning/cases">模拟案例与作业</Link>
+          </p>
+        </details>
+      </div>
+    </div>
+  );
+}
